{
  "name": "pyright-lsp",
  "version": "1.0.0",
  "description": "Python language server (Pyright) for type checking and code intelligence",
  "author": {
    "name": "Anthropic"
  },
  "homepage": "https://github.com/anthropics/claude-plugins-official/tree/main/plugins/pyright-lsp",
  "lspServers": {
    "pyright": {
      "command": "pyright-langserver",
      "args": ["--stdio"],
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      }
    }
  }
}

# Python bytecode and caches.
# Note: build/ and tools/ are SOURCE, not build output — only their caches are ignored.
__pycache__/
*.py[cod]
*$py.class

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Cowork zips
dist/*.zip

# Editor and OS cruft
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
